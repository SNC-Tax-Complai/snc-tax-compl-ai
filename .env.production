# ============================================
# SNC-TAX Compl-Ai™ Production Environment
# ============================================
# Copy this to .env and fill in real values

# ---- Database ----
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_NAME=snc_tax_db
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# ---- Application ----
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://your-domain.co.za
LOG_LEVEL=info

# ---- Security ----
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRY=24h

# ---- AI Providers ----
AI_PROVIDER_DEFAULT=emma-i
EMMA_I_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ---- External APIs ----
SARS_EFILING_URL=
SARS_CLIENT_ID=
SARS_CLIENT_SECRET=

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@your-domain.co.za

# ---- WhatsApp Business ----
WHATSAPP_API_URL=
WHATSAPP_TOKEN=

# ---- File Storage ----
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=52428800

# ---- Frontend (build-time) ----
VITE_API_URL=/api
VITE_APP_NAME=Compl-Ai™ SA
VITE_APP_VERSION=2.0.0
