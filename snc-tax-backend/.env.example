NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=snc_tax_db
DATABASE_USER=postgres
DATABASE_PASSWORD=password

# JWT
JWT_SECRET=your-secret-key-change-in-production

# AI Providers
AI_PROVIDER_DEFAULT=emma-i
EMMA_I_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=

# SARS Integration
SARS_API_URL=https://sars-api.gov.za
SARS_API_KEY=

# Email
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# WhatsApp
WHATSAPP_API_URL=https://graph.instagram.com
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
